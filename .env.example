# ClipFlow environment. Copy to .env (bootstrap.sh does this and fills
# the generated values). NEVER commit .env. Keep a copy in your password manager.

TZ=Asia/Jakarta

# --- Database (generated by bootstrap.sh) ---
POSTGRES_USER=clipflow
POSTGRES_PASSWORD=__GENERATED__
POSTGRES_DB=clipflow

# --- Accounts (P1.5) ---
# First admin, read ONCE while the users table is empty (password generated by bootstrap.sh,
# at least 12 characters). Sign in, change it in Account, then create users in Settings → Users.
# Scripts use per-user API tokens (Account → API tokens, header Authorization: Bearer cf_…);
# there is no shared API key any more. Env only, never app_settings.
CLIPFLOW_ADMIN_USER=admin
CLIPFLOW_ADMIN_PASSWORD=__GENERATED__
CORS_ALLOWED_ORIGINS=http://__VM_IP__

# --- AI providers ---
GEMINI_API_KEY=
GEMINI_MAX_ATTEMPTS=4
# Claude fallback (rebuilt in the AI-provider tasks). Key from console.anthropic.com
ANTHROPIC_API_KEY=
CLAUDE_MODEL_ANALYSIS=
CLAUDE_MODEL_UTILITY=

# --- Transcription ---
# base = what ran before. On the 8-core Ryzen, small or medium gives better Indonesian accuracy.
WHISPER_MODEL=
WHISPER_LANGUAGE=id

# --- Optional integrations ---
SUBMAGIC_API_KEY=
RUNWAY_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
